@model RaceDayMVC.Models.CreateCategoryViewModel
@{
    ViewData["Title"] = "Add Category";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <h2>Add Category to Event</h2>
        <form asp-action="AddCategory" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <!-- THIS IS CRUCIAL -->
            <input type="hidden" asp-for="EventId" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Category Name</label>
                <input asp-for="Name" class="form-control" required />
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="Distance" class="form-label">Distance (km)</label>
                <input asp-for="Distance" type="number" step="0.01" class="form-control" required />
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="MinAge" class="form-label">Min Age</label>
                    <input asp-for="MinAge" type="number" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="MaxAge" class="form-label">Max Age</label>
                    <input asp-for="MaxAge" type="number" class="form-control" />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="MaxCapacity" class="form-label">Max Capacity</label>
                <input asp-for="MaxCapacity" type="number" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Add Category</button>
        </form>
    </div>
</div>