@model RaceDayMVC.Models.EventDetailViewModel
@{
    ViewData["Title"] = "Manage Event";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <div>
        <h2>@Model.Name</h2>
        <p class="text-muted">@Model.Location | @Model.StartDate.ToString("dd MMM yyyy HH:mm")</p>
    </div>
    <div>
        <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Categories</h5>
        <!-- Changed from a button to a link -->
        <a asp-action="AddCategory" asp-route-eventId="@Model.EventId" class="btn btn-sm btn-success">Add Category</a>
    </div>
    <div class="card-body">
        @if (Model.Categories == null || !Model.Categories.Any())
        {
            <p>No categories added yet.</p>
        }
        else
        {
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Distance</th>
                        <th>Age Limit</th>
                        <th>Capacity</th>
                        <th>Enrolled</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in Model.Categories)
                    {
                        <tr>
                            <td>@cat.Name</td>
                            <td>@cat.Distance km</td>
                            <td>@(cat.MinAge.HasValue ? $"{cat.MinAge} - {cat.MaxAge}" : "Any")</td>
                            <td>@cat.MaxCapacity</td>
                            <td>@cat.CurrentEnrolments</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="card border-danger">
    <div class="card-body">
        <h5 class="text-danger">Danger Zone</h5>
        <p>Deleting this event will remove all categories and enrolments permanently.</p>
        <form asp-action="DeleteEvent" asp-route-id="@Model.EventId" method="post" onsubmit="return confirm('Are you sure you want to delete this event?');">
            <button type="submit" class="btn btn-danger">Delete Event</button>
        </form>
    </div>
</div>