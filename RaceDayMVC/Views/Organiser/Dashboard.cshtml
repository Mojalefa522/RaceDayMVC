@model List<RaceDayMVC.Models.EventSummaryViewModel>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2>My Events</h2>
    <a asp-action="CreateEvent" class="btn btn-success">Create New Event</a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">You haven't created any events yet.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Event Name</th>
                <th>Location</th>
                <th>Date</th>
                <th>Status</th>
                <th>Total Enrolments</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ev in Model)
            {
                <tr>
                    <td>@ev.Name</td>
                    <td>@ev.Location</td>
                    <td>@ev.StartDate.ToString("dd MMM yyyy")</td>
                    <td>
                        @if (ev.Status == "open")
                        {
                            <span class="badge bg-success">Open</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@ev.Status</span>
                        }
                    </td>
                    <td>
                        <span class="badge bg-primary rounded-pill">@ev.TotalEnrolments</span>
                    </td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Enrolments" asp-route-eventId="@ev.EventId" class="btn btn-outline-info">Enrolments</a>
                            <a asp-action="Results" asp-route-eventId="@ev.EventId" class="btn btn-outline-warning">Results</a>
                            <a asp-action="ManageEvent" asp-route-id="@ev.EventId" class="btn btn-outline-primary">Manage</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}"<!-- Dashboard View -->" 
